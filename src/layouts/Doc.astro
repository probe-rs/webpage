---
import Html from "./Html.astro";
import { SITE_TITLE } from "../consts";
import { type CollectionEntry, getCollection } from "astro:content";
import { docs, docFolders } from "../utils";
import { Icon } from "astro-icon/components";

type Props = CollectionEntry<"docs">;
const {
  data: { title, description },
  id,
} = Astro.props;
---

<script>
  document.querySelector("#outside-menu")!.addEventListener("click", () => {
    document.querySelector("input")!.checked = false;
  });
</script>

<Html title={`${title} | ${SITE_TITLE}`} description={description} fluid docsSidebar>
  <div class="flex min-w-0 flex-col">
    <label
      class="sticky top-4 peer z-1 md:hidden -mt-10 w-max ml-auto not-prose"
    >
      <Icon
        name="carbon--table-of-contents"
        class="text-[#459087] text-4xl bg-slate-200 dark:bg-slate-800 p-1 opacity-80"
      />
      <input type="checkbox" class="hidden" />
    </label>
    <nav
      class="fixed top-[65px] bottom-0 z-10 min-w-svw md:min-w-3xs md:max-w-3xs pb-10 md:left-[initial] overflow-y-auto font-[Inter] border-r-[1px] bg-white dark:bg-gray-800 border-slate-200 dark:border-slate-600 px-5 left-[-100%] transition-[left_1s_ease_out] peer-has-checked:left-0 not-prose"
    >
      {
        docFolders.map((folder) => (
          <div>
            <h3 class="font-bold my-3">{folder.data.title}</h3>
            {docs[folder.id].map((doc) => (
              <a
                href={import.meta.env.BASE_URL + "docs/" + doc.id}
                title={doc.data.description}
              >
                <p
                  class:list={[
                    "hover:bg-slate-300 dark:bg-gray-800 px-3 py-1 my-1 rounded-md transition",
                    { "bg-slate-200 dark:bg-slate-700": id == doc.id },
                  ]}
                >
                  {doc.data.title}
                </p>
              </a>
            ))}
          </div>
        ))
      }
    </nav>
    <div id="outside-menu" class="pb-10 min-w-0 max-w-full w-full px-4 sm:px-6 md:px-0 md:pl-74 md:pr-10">
      <h3 class="text-4xl font-extrabold mb-3 mt-10 font-[Inter] tracking-wide break-words">
        {title}
      </h3>
      <article class="prose dark:prose-invert format-code min-w-0 break-words
               [&_pre]:max-w-full [&_pre]:overflow-x-auto [&_.expressive-code]:max-w-full"
      >
        <slot />
      </article>
    </div>
  </div>
</Html>
